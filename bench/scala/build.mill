//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0

package build

import mill._, scalalib._, scalafmt.ScalafmtModule
import com.goyeau.mill.scalafix.ScalafixModule

object `package` extends SbtModule with ScalafmtModule with ScalafixModule {

  def scalaVersion = "3.8.1"

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
  )

  def scalafixConfig = Some(moduleDir / ".scalafix.conf")

  def scalafixIvyDeps = Seq(
    mvn"com.github.metals:ming-scalafix-rules_2.13:0.1.0-SNAPSHOT",
  )

  object test extends SbtTests {
    def testFramework = "munit.Framework"

    // bench/ dir contains tests.json and fixtures/
    def forkArgs = Seq(s"-Dbench.dir=${moduleDir / os.up}")

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.0",
      mvn"com.google.code.gson:gson:2.11.0",
    )
  }
}
