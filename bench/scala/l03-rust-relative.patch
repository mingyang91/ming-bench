diff -ruN src/scheme/parser.rs src/scheme/parser.rs
--- src/scheme/parser.rs	1970-01-01 00:00:00.000000000 +0000
+++ src/scheme/parser.rs	2026-03-24 00:46:55.008364007 +0000
@@ -0,0 +1,157 @@
+use super::ast::Expr;
+use super::error::EvalError;
+
+pub fn parse_program(input: &str) -> Result<Vec<Expr>, EvalError> {
+    let mut parser = Parser::new(input);
+    let mut exprs = Vec::new();
+
+    parser.skip_ignored();
+    while !parser.is_done() {
+        exprs.push(parser.parse_expr()?);
+        parser.skip_ignored();
+    }
+
+    Ok(exprs)
+}
+
+struct Parser {
+    chars: Vec<char>,
+    pos: usize,
+}
+
+impl Parser {
+    fn new(input: &str) -> Self {
+        Self {
+            chars: input.chars().collect(),
+            pos: 0,
+        }
+    }
+
+    fn parse_expr(&mut self) -> Result<Expr, EvalError> {
+        self.skip_ignored();
+
+        match self.peek() {
+            Some('(') => self.parse_list(),
+            Some(')') => Err(EvalError::syntax("unexpected ')'")),
+            Some('\'') => {
+                self.pos += 1;
+                let quoted = self.parse_expr()?;
+                Ok(Expr::List(vec![Expr::Symbol("quote".to_string()), quoted]))
+            }
+            Some('"') => self.parse_string(),
+            Some(_) => self.parse_atom(),
+            None => Err(EvalError::syntax("unexpected end of input")),
+        }
+    }
+
+    fn parse_list(&mut self) -> Result<Expr, EvalError> {
+        self.expect('(')?;
+        let mut items = Vec::new();
+
+        loop {
+            self.skip_ignored();
+
+            match self.peek() {
+                Some(')') => {
+                    self.pos += 1;
+                    return Ok(Expr::List(items));
+                }
+                Some(_) => items.push(self.parse_expr()?),
+                None => return Err(EvalError::syntax("unterminated list")),
+            }
+        }
+    }
+
+    fn parse_string(&mut self) -> Result<Expr, EvalError> {
+        self.expect('"')?;
+        let mut value = String::new();
+
+        while let Some(ch) = self.bump() {
+            match ch {
+                '"' => return Ok(Expr::String(value)),
+                '\\' => {
+                    let escaped = match self.bump() {
+                        Some('n') => '\n',
+                        Some('t') => '\t',
+                        Some('"') => '"',
+                        Some('\\') => '\\',
+                        Some(other) => other,
+                        None => return Err(EvalError::syntax("unterminated string")),
+                    };
+                    value.push(escaped);
+                }
+                other => value.push(other),
+            }
+        }
+
+        Err(EvalError::syntax("unterminated string"))
+    }
+
+    fn parse_atom(&mut self) -> Result<Expr, EvalError> {
+        let start = self.pos;
+
+        while let Some(ch) = self.peek() {
+            if ch.is_whitespace() || matches!(ch, '(' | ')' | '\'' | ';') {
+                break;
+            }
+            self.pos += 1;
+        }
+
+        let token: String = self.chars[start..self.pos].iter().collect();
+        if token.is_empty() {
+            return Err(EvalError::syntax("unexpected token"));
+        }
+
+        match token.as_str() {
+            "#t" => Ok(Expr::Bool(true)),
+            "#f" => Ok(Expr::Bool(false)),
+            _ => match token.parse::<i64>() {
+                Ok(value) => Ok(Expr::Int(value)),
+                Err(_) => Ok(Expr::Symbol(token)),
+            },
+        }
+    }
+
+    fn skip_ignored(&mut self) {
+        loop {
+            while matches!(self.peek(), Some(ch) if ch.is_whitespace()) {
+                self.pos += 1;
+            }
+
+            if self.peek() == Some(';') {
+                while let Some(ch) = self.bump() {
+                    if ch == '\n' {
+                        break;
+                    }
+                }
+                continue;
+            }
+
+            break;
+        }
+    }
+
+    fn expect(&mut self, expected: char) -> Result<(), EvalError> {
+        match self.bump() {
+            Some(ch) if ch == expected => Ok(()),
+            Some(ch) => Err(EvalError::syntax(format!(
+                "expected '{expected}', found '{ch}'"
+            ))),
+            None => Err(EvalError::syntax(format!("expected '{expected}'"))),
+        }
+    }
+
+    fn peek(&self) -> Option<char> {
+        self.chars.get(self.pos).copied()
+    }
+
+    fn bump(&mut self) -> Option<char> {
+        let ch = self.peek()?;
+        self.pos += 1;
+        Some(ch)
+    }
+
+    fn is_done(&self) -> bool {
+        self.pos >= self.chars.len()
+    }
+}
diff -ruN src/scheme/value.rs src/scheme/value.rs
--- src/scheme/value.rs	1970-01-01 00:00:00.000000000 +0000
+++ src/scheme/value.rs	2026-03-24 00:46:55.008364007 +0000
@@ -0,0 +1,152 @@
+use std::rc::Rc;
+
+use super::ast::Expr;
+use super::env::EnvRef;
+use super::error::EvalError;
+
+pub type BuiltinFn = fn(&[Value]) -> Result<Value, EvalError>;
+
+#[derive(Clone, Debug)]
+pub enum Value {
+    Int(i64),
+    Bool(bool),
+    String(String),
+    Symbol(String),
+    Nil,
+    Pair(Rc<PairCell>),
+    Function(Rc<Function>),
+    Void,
+}
+
+#[derive(Clone, Debug)]
+pub struct PairCell {
+    pub car: Value,
+    pub cdr: Value,
+}
+
+#[derive(Clone, Debug)]
+pub enum Function {
+    Builtin {
+        name: &'static str,
+        func: BuiltinFn,
+    },
+    Lambda {
+        params: Vec<String>,
+        body: Vec<Expr>,
+        env: EnvRef,
+    },
+}
+
+impl Value {
+    pub fn builtin(name: &'static str, func: BuiltinFn) -> Self {
+        Self::Function(Rc::new(Function::Builtin { name, func }))
+    }
+
+    pub fn lambda(params: Vec<String>, body: Vec<Expr>, env: EnvRef) -> Self {
+        Self::Function(Rc::new(Function::Lambda { params, body, env }))
+    }
+
+    pub fn cons(car: Value, cdr: Value) -> Self {
+        Self::Pair(Rc::new(PairCell { car, cdr }))
+    }
+
+    pub fn is_truthy(&self) -> bool {
+        !matches!(self, Self::Bool(false))
+    }
+
+    pub fn type_name(&self) -> &'static str {
+        match self {
+            Self::Int(_) => "number",
+            Self::Bool(_) => "boolean",
+            Self::String(_) => "string",
+            Self::Symbol(_) => "symbol",
+            Self::Nil => "null",
+            Self::Pair(_) => "pair",
+            Self::Function(_) => "procedure",
+            Self::Void => "void",
+        }
+    }
+
+    pub fn render(&self) -> String {
+        match self {
+            Self::Int(value) => value.to_string(),
+            Self::Bool(true) => "#t".to_string(),
+            Self::Bool(false) => "#f".to_string(),
+            Self::String(value) => render_string(value),
+            Self::Symbol(value) => value.clone(),
+            Self::Nil => "()".to_string(),
+            Self::Pair(pair) => {
+                let mut out = String::from("(");
+                render_pair(pair, &mut out);
+                out.push(')');
+                out
+            }
+            Self::Function(_) => "#<procedure>".to_string(),
+            Self::Void => "#<void>".to_string(),
+        }
+    }
+
+    pub fn as_number(&self) -> Result<i64, EvalError> {
+        match self {
+            Self::Int(value) => Ok(*value),
+            other => Err(EvalError::type_error("number", other.type_name())),
+        }
+    }
+}
+
+pub fn list_from_vec(items: Vec<Value>) -> Value {
+    items
+        .into_iter()
+        .rev()
+        .fold(Value::Nil, |tail, item| Value::cons(item, tail))
+}
+
+pub fn proper_list_to_vec(list: &Value) -> Result<Vec<Value>, EvalError> {
+    let mut items = Vec::new();
+    let mut current = list;
+
+    loop {
+        match current {
+            Value::Nil => return Ok(items),
+            Value::Pair(pair) => {
+                items.push(pair.car.clone());
+                current = &pair.cdr;
+            }
+            other => return Err(EvalError::type_error("proper list", other.type_name())),
+        }
+    }
+}
+
+fn render_pair(pair: &PairCell, out: &mut String) {
+    out.push_str(&pair.car.render());
+
+    match &pair.cdr {
+        Value::Nil => {}
+        Value::Pair(next) => {
+            out.push(' ');
+            render_pair(next, out);
+        }
+        tail => {
+            out.push_str(" . ");
+            out.push_str(&tail.render());
+        }
+    }
+}
+
+fn render_string(value: &str) -> String {
+    let mut rendered = String::with_capacity(value.len() + 2);
+    rendered.push('"');
+
+    for ch in value.chars() {
+        match ch {
+            '\\' => rendered.push_str("\\\\"),
+            '"' => rendered.push_str("\\\""),
+            '\n' => rendered.push_str("\\n"),
+            '\t' => rendered.push_str("\\t"),
+            other => rendered.push(other),
+        }
+    }
+
+    rendered.push('"');
+    rendered
+}
