diff -ruN src/scheme/builtins.rs src/scheme/builtins.rs
--- src/scheme/builtins.rs	1970-01-01 00:00:00.000000000 +0000
+++ src/scheme/builtins.rs	2026-03-24 00:46:55.008364007 +0000
@@ -0,0 +1,207 @@
+use super::env::EnvRef;
+use super::error::EvalError;
+use super::value::{list_from_vec, proper_list_to_vec, Value};
+
+pub fn install(env: &EnvRef) {
+    define(env, "+", builtin_add);
+    define(env, "-", builtin_sub);
+    define(env, "*", builtin_mul);
+    define(env, "/", builtin_div);
+    define(env, "<", builtin_lt);
+    define(env, ">", builtin_gt);
+    define(env, "=", builtin_eq);
+    define(env, "<=", builtin_le);
+    define(env, "not", builtin_not);
+    define(env, "cons", builtin_cons);
+    define(env, "car", builtin_car);
+    define(env, "cdr", builtin_cdr);
+    define(env, "null?", builtin_null);
+    define(env, "list", builtin_list);
+    define(env, "length", builtin_length);
+    define(env, "append", builtin_append);
+    define(env, "string?", builtin_string_pred);
+    define(env, "number?", builtin_number_pred);
+    define(env, "boolean?", builtin_boolean_pred);
+    define(env, "pair?", builtin_pair_pred);
+    define(env, "symbol?", builtin_symbol_pred);
+}
+
+fn define(env: &EnvRef, name: &'static str, func: fn(&[Value]) -> Result<Value, EvalError>) {
+    env.define(name, Value::builtin(name, func));
+}
+
+fn builtin_add(args: &[Value]) -> Result<Value, EvalError> {
+    let mut total = 0_i64;
+    for arg in args {
+        total += arg.as_number()?;
+    }
+    Ok(Value::Int(total))
+}
+
+fn builtin_sub(args: &[Value]) -> Result<Value, EvalError> {
+    if args.is_empty() {
+        return Err(EvalError::arity("-", "at least 1", 0));
+    }
+
+    let first = args[0].as_number()?;
+    if args.len() == 1 {
+        return Ok(Value::Int(-first));
+    }
+
+    let rest = args[1..]
+        .iter()
+        .try_fold(first, |acc, value| Ok(acc - value.as_number()?))?;
+    Ok(Value::Int(rest))
+}
+
+fn builtin_mul(args: &[Value]) -> Result<Value, EvalError> {
+    let mut total = 1_i64;
+    for arg in args {
+        total *= arg.as_number()?;
+    }
+    Ok(Value::Int(total))
+}
+
+fn builtin_div(args: &[Value]) -> Result<Value, EvalError> {
+    if args.len() < 2 {
+        return Err(EvalError::arity("/", "at least 2", args.len()));
+    }
+
+    let mut total = args[0].as_number()?;
+    for value in &args[1..] {
+        let divisor = value.as_number()?;
+        if divisor == 0 {
+            return Err(EvalError::division_by_zero());
+        }
+        total /= divisor;
+    }
+
+    Ok(Value::Int(total))
+}
+
+fn builtin_lt(args: &[Value]) -> Result<Value, EvalError> {
+    compare_numbers("<", args, |a, b| a < b)
+}
+
+fn builtin_gt(args: &[Value]) -> Result<Value, EvalError> {
+    compare_numbers(">", args, |a, b| a > b)
+}
+
+fn builtin_eq(args: &[Value]) -> Result<Value, EvalError> {
+    compare_numbers("=", args, |a, b| a == b)
+}
+
+fn builtin_le(args: &[Value]) -> Result<Value, EvalError> {
+    compare_numbers("<=", args, |a, b| a <= b)
+}
+
+fn builtin_not(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("not", args, 1)?;
+    Ok(Value::Bool(!args[0].is_truthy()))
+}
+
+fn builtin_cons(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("cons", args, 2)?;
+    Ok(Value::cons(args[0].clone(), args[1].clone()))
+}
+
+fn builtin_car(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("car", args, 1)?;
+    match &args[0] {
+        Value::Pair(pair) => Ok(pair.car.clone()),
+        other => Err(EvalError::type_error("pair", other.type_name())),
+    }
+}
+
+fn builtin_cdr(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("cdr", args, 1)?;
+    match &args[0] {
+        Value::Pair(pair) => Ok(pair.cdr.clone()),
+        other => Err(EvalError::type_error("pair", other.type_name())),
+    }
+}
+
+fn builtin_null(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("null?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::Nil)))
+}
+
+fn builtin_list(args: &[Value]) -> Result<Value, EvalError> {
+    Ok(list_from_vec(args.to_vec()))
+}
+
+fn builtin_length(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("length", args, 1)?;
+    let items = proper_list_to_vec(&args[0])?;
+    Ok(Value::Int(items.len() as i64))
+}
+
+fn builtin_append(args: &[Value]) -> Result<Value, EvalError> {
+    if args.is_empty() {
+        return Ok(Value::Nil);
+    }
+
+    let mut result = args
+        .last()
+        .cloned()
+        .ok_or_else(|| EvalError::message("append requires arguments"))?;
+
+    for list in args[..args.len() - 1].iter().rev() {
+        let items = proper_list_to_vec(list)?;
+        for item in items.into_iter().rev() {
+            result = Value::cons(item, result);
+        }
+    }
+
+    Ok(result)
+}
+
+fn builtin_string_pred(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("string?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::String(_))))
+}
+
+fn builtin_number_pred(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("number?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::Int(_))))
+}
+
+fn builtin_boolean_pred(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("boolean?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::Bool(_))))
+}
+
+fn builtin_pair_pred(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("pair?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::Pair(_))))
+}
+
+fn builtin_symbol_pred(args: &[Value]) -> Result<Value, EvalError> {
+    expect_exact_arity("symbol?", args, 1)?;
+    Ok(Value::Bool(matches!(args[0], Value::Symbol(_))))
+}
+
+fn compare_numbers(
+    name: &'static str,
+    args: &[Value],
+    predicate: fn(i64, i64) -> bool,
+) -> Result<Value, EvalError> {
+    if args.len() < 2 {
+        return Err(EvalError::arity(name, "at least 2", args.len()));
+    }
+
+    let numbers = args
+        .iter()
+        .map(Value::as_number)
+        .collect::<Result<Vec<_>, _>>()?;
+    let is_valid = numbers.windows(2).all(|pair| predicate(pair[0], pair[1]));
+    Ok(Value::Bool(is_valid))
+}
+
+fn expect_exact_arity(name: &'static str, args: &[Value], expected: usize) -> Result<(), EvalError> {
+    if args.len() == expected {
+        return Ok(());
+    }
+
+    Err(EvalError::arity(name, expected.to_string(), args.len()))
+}
diff -ruN src/scheme/env.rs src/scheme/env.rs
--- src/scheme/env.rs	1970-01-01 00:00:00.000000000 +0000
+++ src/scheme/env.rs	2026-03-24 00:46:55.008364007 +0000
@@ -0,0 +1,41 @@
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use super::value::Value;
+
+pub type EnvRef = Rc<Env>;
+
+#[derive(Debug)]
+pub struct Env {
+    parent: Option<EnvRef>,
+    bindings: RefCell<HashMap<String, Value>>,
+}
+
+impl Env {
+    pub fn new() -> EnvRef {
+        Rc::new(Self {
+            parent: None,
+            bindings: RefCell::new(HashMap::new()),
+        })
+    }
+
+    pub fn child(parent: &EnvRef) -> EnvRef {
+        Rc::new(Self {
+            parent: Some(Rc::clone(parent)),
+            bindings: RefCell::new(HashMap::new()),
+        })
+    }
+
+    pub fn define(&self, name: impl Into<String>, value: Value) {
+        self.bindings.borrow_mut().insert(name.into(), value);
+    }
+
+    pub fn lookup(&self, name: &str) -> Option<Value> {
+        if let Some(value) = self.bindings.borrow().get(name).cloned() {
+            return Some(value);
+        }
+
+        self.parent.as_ref().and_then(|parent| parent.lookup(name))
+    }
+}
diff -ruN src/scheme/error.rs src/scheme/error.rs
--- src/scheme/error.rs	2026-03-23 23:45:29.832378071 +0000
+++ src/scheme/error.rs	2026-03-24 00:46:55.008364007 +0000
@@ -4,7 +4,71 @@
 /// error type is not possible — the `eval_str` signature requires this type.
 #[derive(Debug, PartialEq, thiserror::Error)]
 pub enum EvalError {
-    // Add variants as needed, e.g.:
-    // #[error("unbound variable: {name}")]
-    // UnboundVariable { name: String },
+    #[error("syntax error: {message}")]
+    Syntax { message: String },
+
+    #[error("unbound variable: {name}")]
+    UnboundVariable { name: String },
+
+    #[error("{name} expected {expected} argument(s), got {got}")]
+    Arity {
+        name: String,
+        expected: String,
+        got: usize,
+    },
+
+    #[error("expected {expected}, got {found}")]
+    TypeError { expected: String, found: String },
+
+    #[error("{found} is not a procedure")]
+    NotAProcedure { found: String },
+
+    #[error("division by zero")]
+    DivisionByZero,
+
+    #[error("{message}")]
+    Message { message: String },
+}
+
+impl EvalError {
+    pub fn syntax(message: impl Into<String>) -> Self {
+        Self::Syntax {
+            message: message.into(),
+        }
+    }
+
+    pub fn unbound_variable(name: impl Into<String>) -> Self {
+        Self::UnboundVariable { name: name.into() }
+    }
+
+    pub fn arity(name: impl Into<String>, expected: impl Into<String>, got: usize) -> Self {
+        Self::Arity {
+            name: name.into(),
+            expected: expected.into(),
+            got,
+        }
+    }
+
+    pub fn type_error(expected: impl Into<String>, found: impl Into<String>) -> Self {
+        Self::TypeError {
+            expected: expected.into(),
+            found: found.into(),
+        }
+    }
+
+    pub fn not_a_procedure(found: impl Into<String>) -> Self {
+        Self::NotAProcedure {
+            found: found.into(),
+        }
+    }
+
+    pub fn division_by_zero() -> Self {
+        Self::DivisionByZero
+    }
+
+    pub fn message(message: impl Into<String>) -> Self {
+        Self::Message {
+            message: message.into(),
+        }
+    }
 }
diff -ruN src/scheme/evaluator.rs src/scheme/evaluator.rs
--- src/scheme/evaluator.rs	1970-01-01 00:00:00.000000000 +0000
+++ src/scheme/evaluator.rs	2026-03-24 00:47:05.532363992 +0000
@@ -0,0 +1,332 @@
+use std::rc::Rc;
+
+use super::ast::Expr;
+use super::builtins;
+use super::env::{Env, EnvRef};
+use super::error::EvalError;
+use super::parser::parse_program;
+use super::value::{list_from_vec, Function, Value};
+
+pub struct Evaluator {
+    global: EnvRef,
+    output: String,
+}
+
+impl Evaluator {
+    pub fn new() -> Self {
+        let global = Env::new();
+        builtins::install(&global);
+
+        Self {
+            global,
+            output: String::new(),
+        }
+    }
+
+    pub fn eval(mut self, input: &str) -> Result<(Value, String), EvalError> {
+        let exprs = parse_program(input)?;
+        let global = Rc::clone(&self.global);
+        let result = self.eval_sequence(&exprs, &global)?;
+        Ok((result, self.output))
+    }
+
+    fn eval_sequence(&mut self, exprs: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let mut last = Value::Void;
+
+        for expr in exprs {
+            last = self.eval_expr(expr, env)?;
+        }
+
+        Ok(last)
+    }
+
+    fn eval_expr(&mut self, expr: &Expr, env: &EnvRef) -> Result<Value, EvalError> {
+        match expr {
+            Expr::Int(value) => Ok(Value::Int(*value)),
+            Expr::Bool(value) => Ok(Value::Bool(*value)),
+            Expr::String(value) => Ok(Value::String(value.clone())),
+            Expr::Symbol(name) => env
+                .lookup(name)
+                .ok_or_else(|| EvalError::unbound_variable(name.clone())),
+            Expr::List(items) => self.eval_list(items, env),
+        }
+    }
+
+    fn eval_list(&mut self, items: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        if items.is_empty() {
+            return Ok(Value::Nil);
+        }
+
+        match &items[0] {
+            Expr::Symbol(symbol) => match symbol.as_str() {
+                "quote" => self.eval_quote(&items[1..]),
+                "if" => self.eval_if(&items[1..], env),
+                "define" => self.eval_define(&items[1..], env),
+                "lambda" => self.eval_lambda(&items[1..], env),
+                "and" => self.eval_and(&items[1..], env),
+                "or" => self.eval_or(&items[1..], env),
+                "let" => self.eval_let(&items[1..], env),
+                "begin" => self.eval_sequence(&items[1..], env),
+                "cond" => self.eval_cond(&items[1..], env),
+                _ => self.eval_call(items, env),
+            },
+            _ => self.eval_call(items, env),
+        }
+    }
+
+    fn eval_quote(&self, args: &[Expr]) -> Result<Value, EvalError> {
+        if args.len() != 1 {
+            return Err(EvalError::arity("quote", 1.to_string(), args.len()));
+        }
+
+        Ok(quote_to_value(&args[0]))
+    }
+
+    fn eval_if(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        if args.len() != 3 {
+            return Err(EvalError::arity("if", 3.to_string(), args.len()));
+        }
+
+        let test = self.eval_expr(&args[0], env)?;
+        if test.is_truthy() {
+            self.eval_expr(&args[1], env)
+        } else {
+            self.eval_expr(&args[2], env)
+        }
+    }
+
+    fn eval_define(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let (target, body) = args
+            .split_first()
+            .ok_or_else(|| EvalError::syntax("define requires a target"))?;
+
+        match target {
+            Expr::Symbol(name) => {
+                if body.len() != 1 {
+                    return Err(EvalError::arity("define", 2.to_string(), args.len()));
+                }
+
+                let value = self.eval_expr(&body[0], env)?;
+                env.define(name.clone(), value);
+                Ok(Value::Void)
+            }
+            Expr::List(signature) => {
+                let (name, params) = parse_signature(signature)?;
+                if body.is_empty() {
+                    return Err(EvalError::syntax("function definition requires a body"));
+                }
+
+                let function = Value::lambda(params, body.to_vec(), Rc::clone(env));
+                env.define(name, function);
+                Ok(Value::Void)
+            }
+            _ => Err(EvalError::syntax("invalid define target")),
+        }
+    }
+
+    fn eval_lambda(&self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        if args.len() < 2 {
+            return Err(EvalError::syntax("lambda requires parameters and a body"));
+        }
+
+        let params = parse_params(&args[0])?;
+        let body = args[1..].to_vec();
+        Ok(Value::lambda(params, body, Rc::clone(env)))
+    }
+
+    fn eval_and(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let mut last = Value::Bool(true);
+
+        for expr in args {
+            last = self.eval_expr(expr, env)?;
+            if !last.is_truthy() {
+                return Ok(last);
+            }
+        }
+
+        Ok(last)
+    }
+
+    fn eval_or(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        for expr in args {
+            let value = self.eval_expr(expr, env)?;
+            if value.is_truthy() {
+                return Ok(value);
+            }
+        }
+
+        Ok(Value::Bool(false))
+    }
+
+    fn eval_let(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        if args.len() < 2 {
+            return Err(EvalError::syntax("let requires bindings and a body"));
+        }
+
+        match &args[0] {
+            Expr::Symbol(name) => self.eval_named_let(name, &args[1], &args[2..], env),
+            bindings => self.eval_plain_let(bindings, &args[1..], env),
+        }
+    }
+
+    fn eval_plain_let(
+        &mut self,
+        bindings_expr: &Expr,
+        body: &[Expr],
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        let bindings = parse_bindings(bindings_expr)?;
+        let local = Env::child(env);
+
+        for (name, expr) in bindings {
+            let value = self.eval_expr(&expr, env)?;
+            local.define(name, value);
+        }
+
+        self.eval_sequence(body, &local)
+    }
+
+    fn eval_named_let(
+        &mut self,
+        name: &str,
+        bindings_expr: &Expr,
+        body: &[Expr],
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if body.is_empty() {
+            return Err(EvalError::syntax("named let requires a body"));
+        }
+
+        let bindings = parse_bindings(bindings_expr)?;
+        let params = bindings.iter().map(|(param, _)| param.clone()).collect();
+        let mut values = Vec::with_capacity(bindings.len());
+
+        for (_, expr) in &bindings {
+            values.push(self.eval_expr(expr, env)?);
+        }
+
+        let local = Env::child(env);
+        let function = Value::lambda(params, body.to_vec(), Rc::clone(&local));
+        local.define(name.to_string(), function.clone());
+        self.apply(function, values)
+    }
+
+    fn eval_cond(&mut self, clauses: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        for clause in clauses {
+            let Expr::List(items) = clause else {
+                return Err(EvalError::syntax("cond clause must be a list"));
+            };
+
+            let (test_expr, body) = items
+                .split_first()
+                .ok_or_else(|| EvalError::syntax("cond clause must not be empty"))?;
+
+            if matches!(test_expr, Expr::Symbol(symbol) if symbol == "else") {
+                return self.eval_sequence(body, env);
+            }
+
+            let test = self.eval_expr(test_expr, env)?;
+            if test.is_truthy() {
+                if body.is_empty() {
+                    return Ok(test);
+                }
+                return self.eval_sequence(body, env);
+            }
+        }
+
+        Ok(Value::Void)
+    }
+
+    fn eval_call(&mut self, items: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let function = self.eval_expr(&items[0], env)?;
+        let mut args = Vec::with_capacity(items.len().saturating_sub(1));
+
+        for expr in &items[1..] {
+            args.push(self.eval_expr(expr, env)?);
+        }
+
+        self.apply(function, args)
+    }
+
+    fn apply(&mut self, function: Value, args: Vec<Value>) -> Result<Value, EvalError> {
+        match function {
+            Value::Function(callable) => match callable.as_ref() {
+                Function::Builtin { func, .. } => func(&args),
+                Function::Lambda { params, body, env } => {
+                    if params.len() != args.len() {
+                        return Err(EvalError::arity(
+                            "lambda",
+                            params.len().to_string(),
+                            args.len(),
+                        ));
+                    }
+
+                    let call_env = Env::child(env);
+                    for (param, value) in params.iter().zip(args) {
+                        call_env.define(param.clone(), value);
+                    }
+
+                    self.eval_sequence(body, &call_env)
+                }
+            },
+            other => Err(EvalError::not_a_procedure(other.type_name())),
+        }
+    }
+}
+
+fn parse_signature(signature: &[Expr]) -> Result<(String, Vec<String>), EvalError> {
+    let (name_expr, params_expr) = signature
+        .split_first()
+        .ok_or_else(|| EvalError::syntax("function definition requires a name"))?;
+
+    let Expr::Symbol(name) = name_expr else {
+        return Err(EvalError::syntax("function name must be a symbol"));
+    };
+
+    let params = params_expr
+        .iter()
+        .map(expect_symbol)
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok((name.clone(), params))
+}
+
+fn parse_params(expr: &Expr) -> Result<Vec<String>, EvalError> {
+    match expr {
+        Expr::List(items) => items.iter().map(expect_symbol).collect(),
+        _ => Err(EvalError::syntax("lambda parameters must be a list")),
+    }
+}
+
+fn parse_bindings(expr: &Expr) -> Result<Vec<(String, Expr)>, EvalError> {
+    let Expr::List(bindings) = expr else {
+        return Err(EvalError::syntax("let bindings must be a list"));
+    };
+
+    bindings
+        .iter()
+        .map(|binding| match binding {
+            Expr::List(items) if items.len() == 2 => {
+                let name = expect_symbol(&items[0])?;
+                Ok((name, items[1].clone()))
+            }
+            _ => Err(EvalError::syntax("binding must have the form (name expr)")),
+        })
+        .collect()
+}
+
+fn expect_symbol(expr: &Expr) -> Result<String, EvalError> {
+    match expr {
+        Expr::Symbol(symbol) => Ok(symbol.clone()),
+        _ => Err(EvalError::syntax("expected symbol")),
+    }
+}
+
+fn quote_to_value(expr: &Expr) -> Value {
+    match expr {
+        Expr::Int(value) => Value::Int(*value),
+        Expr::Bool(value) => Value::Bool(*value),
+        Expr::String(value) => Value::String(value.clone()),
+        Expr::Symbol(value) => Value::Symbol(value.clone()),
+        Expr::List(items) => list_from_vec(items.iter().map(quote_to_value).collect()),
+    }
+}
