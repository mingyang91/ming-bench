+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SourcePos {
+    pub line: usize,
+    pub column: usize,
+}
+
+impl SourcePos {
+    pub const fn new(line: usize, column: usize) -> Self {
+        Self { line, column }
+    }
+}
