@@ -0,0 +1,161 @@
+use std::rc::Rc;
+
+use super::ast::Expr;
+use super::env::EnvRef;
+use super::error::{EvalError, SourcePos};
+
+pub type BuiltinFn = fn(&[Value], SourcePos) -> Result<Value, EvalError>;
+
+#[derive(Clone, Debug)]
+pub enum Value {
+    Int(i64),
+    Bool(bool),
+    String(String),
+    Symbol(String),
+    Nil,
+    Pair(Rc<PairCell>),
+    Function(Rc<Function>),
+    Void,
+}
+
+#[derive(Clone, Debug)]
+pub struct PairCell {
+    pub car: Value,
+    pub cdr: Value,
+}
+
+#[derive(Clone, Debug)]
+pub enum Function {
+    Builtin {
+        name: &'static str,
+        func: BuiltinFn,
+    },
+    Lambda {
+        params: Vec<String>,
+        body: Vec<Expr>,
+        env: EnvRef,
+    },
+}
+
+impl Value {
+    pub fn builtin(name: &'static str, func: BuiltinFn) -> Self {
+        Self::Function(Rc::new(Function::Builtin { name, func }))
+    }
+
+    pub fn lambda(params: Vec<String>, body: Vec<Expr>, env: EnvRef) -> Self {
+        Self::Function(Rc::new(Function::Lambda { params, body, env }))
+    }
+
+    pub fn cons(car: Value, cdr: Value) -> Self {
+        Self::Pair(Rc::new(PairCell { car, cdr }))
+    }
+
+    pub fn is_truthy(&self) -> bool {
+        !matches!(self, Self::Bool(false))
+    }
+
+    pub fn type_name(&self) -> &'static str {
+        match self {
+            Self::Int(_) => "number",
+            Self::Bool(_) => "boolean",
+            Self::String(_) => "string",
+            Self::Symbol(_) => "symbol",
+            Self::Nil => "null",
+            Self::Pair(_) => "pair",
+            Self::Function(_) => "procedure",
+            Self::Void => "void",
+        }
+    }
+
+    pub fn render(&self) -> String {
+        match self {
+            Self::Int(value) => value.to_string(),
+            Self::Bool(true) => "#t".to_string(),
+            Self::Bool(false) => "#f".to_string(),
+            Self::String(value) => render_string(value),
+            Self::Symbol(value) => value.clone(),
+            Self::Nil => "()".to_string(),
+            Self::Pair(pair) => {
+                let mut out = String::from("(");
+                render_pair(pair, &mut out);
+                out.push(')');
+                out
+            }
+            Self::Function(function) => match function.as_ref() {
+                Function::Builtin { name, .. } => format!("#<procedure:{name}>"),
+                Function::Lambda { .. } => "#<procedure>".to_string(),
+            },
+            Self::Void => "#<void>".to_string(),
+        }
+    }
+
+    pub fn as_number(&self, position: SourcePos) -> Result<i64, EvalError> {
+        match self {
+            Self::Int(value) => Ok(*value),
+            other => Err(EvalError::type_error("number", other.type_name(), position)),
+        }
+    }
+}
+
+pub fn list_from_vec(items: Vec<Value>) -> Value {
+    items
+        .into_iter()
+        .rev()
+        .fold(Value::Nil, |tail, item| Value::cons(item, tail))
+}
+
+pub fn proper_list_to_vec(list: &Value, position: SourcePos) -> Result<Vec<Value>, EvalError> {
+    let mut items = Vec::new();
+    let mut current = list;
+
+    loop {
+        match current {
+            Value::Nil => return Ok(items),
+            Value::Pair(pair) => {
+                items.push(pair.car.clone());
+                current = &pair.cdr;
+            }
+            other => {
+                return Err(EvalError::type_error(
+                    "proper list",
+                    other.type_name(),
+                    position,
+                ))
+            }
+        }
+    }
+}
+
+fn render_pair(pair: &PairCell, out: &mut String) {
+    out.push_str(&pair.car.render());
+
+    match &pair.cdr {
+        Value::Nil => {}
+        Value::Pair(next) => {
+            out.push(' ');
+            render_pair(next, out);
+        }
+        tail => {
+            out.push_str(" . ");
+            out.push_str(&tail.render());
+        }
+    }
+}
+
+fn render_string(value: &str) -> String {
+    let mut rendered = String::with_capacity(value.len() + 2);
+    rendered.push('"');
+
+    for ch in value.chars() {
+        match ch {
+            '\\' => rendered.push_str("\\\\"),
+            '"' => rendered.push_str("\\\""),
+            '\n' => rendered.push_str("\\n"),
+            '\t' => rendered.push_str("\\t"),
+            other => rendered.push(other),
+        }
+    }
+
+    rendered.push('"');
+    rendered
+}
