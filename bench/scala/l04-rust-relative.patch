@@ -0,0 +1,395 @@
+use std::rc::Rc;
+
+use super::ast::{Expr, ExprKind};
+use super::builtins;
+use super::env::{Env, EnvRef};
+use super::error::{EvalError, SourcePos};
+use super::parser::parse_program;
+use super::value::{list_from_vec, Function, Value};
+
+pub struct Evaluator {
+    global: EnvRef,
+    output: String,
+}
+
+impl Evaluator {
+    pub fn new() -> Self {
+        let global = Env::new();
+        builtins::install(&global);
+
+        Self {
+            global,
+            output: String::new(),
+        }
+    }
+
+    pub fn eval(mut self, input: &str) -> Result<(Value, String), EvalError> {
+        let exprs = parse_program(input)?;
+        let global = Rc::clone(&self.global);
+        let result = self.eval_sequence(&exprs, &global)?;
+        Ok((result, self.output))
+    }
+
+    fn eval_sequence(&mut self, exprs: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let mut last = Value::Void;
+        for expr in exprs {
+            last = self.eval_expr(expr, env)?;
+        }
+        Ok(last)
+    }
+
+    fn eval_expr(&mut self, expr: &Expr, env: &EnvRef) -> Result<Value, EvalError> {
+        match &expr.kind {
+            ExprKind::Int(value) => Ok(Value::Int(*value)),
+            ExprKind::Bool(value) => Ok(Value::Bool(*value)),
+            ExprKind::String(value) => Ok(Value::String(value.clone())),
+            ExprKind::Symbol(name) => env
+                .lookup(name)
+                .ok_or_else(|| EvalError::unbound_variable(name.clone(), expr.pos)),
+            ExprKind::List(items) => self.eval_list(items, expr.pos, env),
+        }
+    }
+
+    fn eval_list(
+        &mut self,
+        items: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if items.is_empty() {
+            return Ok(Value::Nil);
+        }
+
+        match &items[0].kind {
+            ExprKind::Symbol(symbol) => match symbol.as_str() {
+                "quote" => self.eval_quote(&items[1..], items[0].pos),
+                "if" => self.eval_if(&items[1..], items[0].pos, env),
+                "define" => self.eval_define(&items[1..], items[0].pos, env),
+                "lambda" => self.eval_lambda(&items[1..], items[0].pos, env),
+                "and" => self.eval_and(&items[1..], env),
+                "or" => self.eval_or(&items[1..], env),
+                "let" => self.eval_let(&items[1..], items[0].pos, env),
+                "begin" => self.eval_sequence(&items[1..], env),
+                "cond" => self.eval_cond(&items[1..], env),
+                _ => self.eval_call(items, position, env),
+            },
+            _ => self.eval_call(items, position, env),
+        }
+    }
+
+    fn eval_quote(&self, args: &[Expr], position: SourcePos) -> Result<Value, EvalError> {
+        if args.len() != 1 {
+            return Err(EvalError::arity(
+                "quote",
+                1.to_string(),
+                args.len(),
+                position,
+            ));
+        }
+
+        Ok(quote_to_value(&args[0]))
+    }
+
+    fn eval_if(
+        &mut self,
+        args: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if args.len() != 3 {
+            return Err(EvalError::arity("if", 3.to_string(), args.len(), position));
+        }
+
+        let test = self.eval_expr(&args[0], env)?;
+        if test.is_truthy() {
+            self.eval_expr(&args[1], env)
+        } else {
+            self.eval_expr(&args[2], env)
+        }
+    }
+
+    fn eval_define(
+        &mut self,
+        args: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        let (target, body) = args
+            .split_first()
+            .ok_or_else(|| EvalError::syntax("define requires a target", position))?;
+
+        match &target.kind {
+            ExprKind::Symbol(name) => {
+                if body.len() != 1 {
+                    return Err(EvalError::arity(
+                        "define",
+                        2.to_string(),
+                        args.len(),
+                        position,
+                    ));
+                }
+
+                let value = self.eval_expr(&body[0], env)?;
+                env.define(name.clone(), value);
+                Ok(Value::Void)
+            }
+            ExprKind::List(signature) => {
+                let (name, params) = parse_signature(signature, target.pos)?;
+                if body.is_empty() {
+                    return Err(EvalError::syntax(
+                        "function definition requires a body",
+                        position,
+                    ));
+                }
+
+                let function = Value::lambda(params, body.to_vec(), Rc::clone(env));
+                env.define(name, function);
+                Ok(Value::Void)
+            }
+            _ => Err(EvalError::syntax("invalid define target", target.pos)),
+        }
+    }
+
+    fn eval_lambda(
+        &self,
+        args: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if args.len() < 2 {
+            return Err(EvalError::syntax(
+                "lambda requires parameters and a body",
+                position,
+            ));
+        }
+
+        let params = parse_params(&args[0])?;
+        let body = args[1..].to_vec();
+        Ok(Value::lambda(params, body, Rc::clone(env)))
+    }
+
+    fn eval_and(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        let mut last = Value::Bool(true);
+        for expr in args {
+            last = self.eval_expr(expr, env)?;
+            if !last.is_truthy() {
+                return Ok(last);
+            }
+        }
+        Ok(last)
+    }
+
+    fn eval_or(&mut self, args: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        for expr in args {
+            let value = self.eval_expr(expr, env)?;
+            if value.is_truthy() {
+                return Ok(value);
+            }
+        }
+        Ok(Value::Bool(false))
+    }
+
+    fn eval_let(
+        &mut self,
+        args: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if args.len() < 2 {
+            return Err(EvalError::syntax(
+                "let requires bindings and a body",
+                position,
+            ));
+        }
+
+        match &args[0].kind {
+            ExprKind::Symbol(name) => {
+                self.eval_named_let(name, &args[1], &args[2..], position, env)
+            }
+            _ => self.eval_plain_let(&args[0], &args[1..], env),
+        }
+    }
+
+    fn eval_plain_let(
+        &mut self,
+        bindings_expr: &Expr,
+        body: &[Expr],
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        let bindings = parse_bindings(bindings_expr)?;
+        let local = Env::child(env);
+
+        for (name, expr) in bindings {
+            let value = self.eval_expr(&expr, env)?;
+            local.define(name, value);
+        }
+
+        self.eval_sequence(body, &local)
+    }
+
+    fn eval_named_let(
+        &mut self,
+        name: &str,
+        bindings_expr: &Expr,
+        body: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        if body.is_empty() {
+            return Err(EvalError::syntax("named let requires a body", position));
+        }
+
+        let bindings = parse_bindings(bindings_expr)?;
+        let params = bindings.iter().map(|(param, _)| param.clone()).collect();
+        let mut values = Vec::with_capacity(bindings.len());
+
+        for (_, expr) in &bindings {
+            values.push(self.eval_expr(expr, env)?);
+        }
+
+        let local = Env::child(env);
+        let function = Value::lambda(params, body.to_vec(), Rc::clone(&local));
+        local.define(name.to_string(), function.clone());
+        self.apply(function, values, position)
+    }
+
+    fn eval_cond(&mut self, clauses: &[Expr], env: &EnvRef) -> Result<Value, EvalError> {
+        for clause in clauses {
+            let ExprKind::List(items) = &clause.kind else {
+                return Err(EvalError::syntax("cond clause must be a list", clause.pos));
+            };
+
+            let (test_expr, body) = items
+                .split_first()
+                .ok_or_else(|| EvalError::syntax("cond clause must not be empty", clause.pos))?;
+
+            if matches!(&test_expr.kind, ExprKind::Symbol(symbol) if symbol == "else") {
+                return self.eval_sequence(body, env);
+            }
+
+            let test = self.eval_expr(test_expr, env)?;
+            if test.is_truthy() {
+                if body.is_empty() {
+                    return Ok(test);
+                }
+                return self.eval_sequence(body, env);
+            }
+        }
+
+        Ok(Value::Void)
+    }
+
+    fn eval_call(
+        &mut self,
+        items: &[Expr],
+        position: SourcePos,
+        env: &EnvRef,
+    ) -> Result<Value, EvalError> {
+        let function = self.eval_expr(&items[0], env)?;
+        let mut args = Vec::with_capacity(items.len().saturating_sub(1));
+        for expr in &items[1..] {
+            args.push(self.eval_expr(expr, env)?);
+        }
+        self.apply(function, args, position)
+    }
+
+    fn apply(
+        &mut self,
+        function: Value,
+        args: Vec<Value>,
+        position: SourcePos,
+    ) -> Result<Value, EvalError> {
+        match function {
+            Value::Function(callable) => match callable.as_ref() {
+                Function::Builtin { func, .. } => func(&args, position),
+                Function::Lambda { params, body, env } => {
+                    if params.len() != args.len() {
+                        return Err(EvalError::arity(
+                            "lambda",
+                            params.len().to_string(),
+                            args.len(),
+                            position,
+                        ));
+                    }
+
+                    let call_env = Env::child(env);
+                    for (param, value) in params.iter().zip(args) {
+                        call_env.define(param.clone(), value);
+                    }
+
+                    self.eval_sequence(body, &call_env)
+                }
+            },
+            other => Err(EvalError::not_a_procedure(other.type_name(), position)),
+        }
+    }
+}
+
+fn parse_signature(
+    signature: &[Expr],
+    position: SourcePos,
+) -> Result<(String, Vec<String>), EvalError> {
+    let (name_expr, params_expr) = signature
+        .split_first()
+        .ok_or_else(|| EvalError::syntax("function definition requires a name", position))?;
+
+    let ExprKind::Symbol(name) = &name_expr.kind else {
+        return Err(EvalError::syntax(
+            "function name must be a symbol",
+            name_expr.pos,
+        ));
+    };
+
+    let params = params_expr
+        .iter()
+        .map(expect_symbol)
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok((name.clone(), params))
+}
+
+fn parse_params(expr: &Expr) -> Result<Vec<String>, EvalError> {
+    match &expr.kind {
+        ExprKind::List(items) => items.iter().map(expect_symbol).collect(),
+        _ => Err(EvalError::syntax(
+            "lambda parameters must be a list",
+            expr.pos,
+        )),
+    }
+}
+
+fn parse_bindings(expr: &Expr) -> Result<Vec<(String, Expr)>, EvalError> {
+    let ExprKind::List(bindings) = &expr.kind else {
+        return Err(EvalError::syntax("let bindings must be a list", expr.pos));
+    };
+
+    bindings
+        .iter()
+        .map(|binding| match &binding.kind {
+            ExprKind::List(items) if items.len() == 2 => {
+                let name = expect_symbol(&items[0])?;
+                Ok((name, items[1].clone()))
+            }
+            _ => Err(EvalError::syntax(
+                "binding must have the form (name expr)",
+                binding.pos,
+            )),
+        })
+        .collect()
+}
+
+fn expect_symbol(expr: &Expr) -> Result<String, EvalError> {
+    match &expr.kind {
+        ExprKind::Symbol(symbol) => Ok(symbol.clone()),
+        _ => Err(EvalError::syntax("expected symbol", expr.pos)),
+    }
+}
+
+fn quote_to_value(expr: &Expr) -> Value {
+    match &expr.kind {
+        ExprKind::Int(value) => Value::Int(*value),
+        ExprKind::Bool(value) => Value::Bool(*value),
+        ExprKind::String(value) => Value::String(value.clone()),
+        ExprKind::Symbol(value) => Value::Symbol(value.clone()),
+        ExprKind::List(items) => list_from_vec(items.iter().map(quote_to_value).collect()),
+    }
+}
