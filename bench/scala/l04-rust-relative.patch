+use super::ast::{Expr, ExprKind};
+use super::error::{EvalError, SourcePos};
+
+pub fn parse_program(input: &str) -> Result<Vec<Expr>, EvalError> {
+    let mut parser = Parser::new(input);
+    let mut exprs = Vec::new();
+
+    parser.skip_ignored();
+    while !parser.is_done() {
+        exprs.push(parser.parse_expr()?);
+        parser.skip_ignored();
+    }
+
+    Ok(exprs)
+}
+
+struct Parser {
+    chars: Vec<char>,
+    pos: usize,
+    line: usize,
+    column: usize,
+}
+
+impl Parser {
+    fn new(input: &str) -> Self {
+        Self {
+            chars: input.chars().collect(),
+            pos: 0,
+            line: 1,
+            column: 1,
+        }
+    }
+
+    fn parse_expr(&mut self) -> Result<Expr, EvalError> {
+        self.skip_ignored();
+
+        let position = self.current_pos();
+        match self.peek() {
+            Some('(') => self.parse_list(position),
+            Some(')') => Err(EvalError::syntax("unexpected ')'", position)),
+            Some('\'') => {
+                self.bump();
+                let quoted = self.parse_expr()?;
+                let quote_symbol = Expr::new(ExprKind::Symbol("quote".to_string()), position);
+                Ok(Expr::new(
+                    ExprKind::List(vec![quote_symbol, quoted]),
+                    position,
+                ))
+            }
+            Some('"') => self.parse_string(position),
+            Some(_) => self.parse_atom(position),
+            None => Err(EvalError::syntax("unexpected end of input", position)),
+        }
+    }
+
+    fn parse_list(&mut self, position: SourcePos) -> Result<Expr, EvalError> {
+        self.expect('(', position)?;
+        let mut items = Vec::new();
+
+        loop {
+            self.skip_ignored();
+            match self.peek() {
+                Some(')') => {
+                    self.bump();
+                    return Ok(Expr::new(ExprKind::List(items), position));
+                }
+                Some(_) => items.push(self.parse_expr()?),
+                None => return Err(EvalError::syntax("unterminated list", position)),
+            }
+        }
+    }
+
+    fn parse_string(&mut self, position: SourcePos) -> Result<Expr, EvalError> {
+        self.expect('"', position)?;
+        let mut value = String::new();
+
+        while let Some(ch) = self.bump() {
+            match ch {
+                '"' => return Ok(Expr::new(ExprKind::String(value), position)),
+                '\\' => {
+                    let escaped = match self.bump() {
+                        Some('n') => '\n',
+                        Some('t') => '\t',
+                        Some('"') => '"',
+                        Some('\\') => '\\',
+                        Some(other) => other,
+                        None => return Err(EvalError::syntax("unterminated string", position)),
+                    };
+                    value.push(escaped);
+                }
+                other => value.push(other),
+            }
+        }
+
+        Err(EvalError::syntax("unterminated string", position))
+    }
+
+    fn parse_atom(&mut self, position: SourcePos) -> Result<Expr, EvalError> {
+        let start = self.pos;
+        while let Some(ch) = self.peek() {
+            if ch.is_whitespace() || matches!(ch, '(' | ')' | '\'' | ';') {
+                break;
+            }
+            self.bump();
+        }
+
+        let token: String = self.chars[start..self.pos].iter().collect();
+        if token.is_empty() {
+            return Err(EvalError::syntax("unexpected token", position));
+        }
+
+        let kind = match token.as_str() {
+            "#t" => ExprKind::Bool(true),
+            "#f" => ExprKind::Bool(false),
+            _ => match token.parse::<i64>() {
+                Ok(value) => ExprKind::Int(value),
+                Err(_) => ExprKind::Symbol(token),
+            },
+        };
+
+        Ok(Expr::new(kind, position))
+    }
+
+    fn skip_ignored(&mut self) {
+        loop {
+            while matches!(self.peek(), Some(ch) if ch.is_whitespace()) {
+                self.bump();
+            }
+
+            if self.peek() == Some(';') {
+                while let Some(ch) = self.bump() {
+                    if ch == '\n' {
+                        break;
+                    }
+                }
+                continue;
+            }
+
+            break;
+        }
+    }
+
+    fn expect(&mut self, expected: char, position: SourcePos) -> Result<(), EvalError> {
+        match self.bump() {
+            Some(ch) if ch == expected => Ok(()),
+            Some(ch) => Err(EvalError::syntax(
+                format!("expected '{expected}', found '{ch}'"),
+                position,
+            )),
+            None => Err(EvalError::syntax(
+                format!("expected '{expected}'"),
+                position,
+            )),
+        }
+    }
+
+    fn current_pos(&self) -> SourcePos {
+        SourcePos::new(self.line, self.column)
+    }
+
+    fn peek(&self) -> Option<char> {
+        self.chars.get(self.pos).copied()
+    }
+
+    fn bump(&mut self) -> Option<char> {
+        let ch = self.peek()?;
+        self.pos += 1;
+        if ch == '\n' {
+            self.line += 1;
+            self.column = 1;
+        } else {
+            self.column += 1;
+        }
+        Some(ch)
+    }
+
+    fn is_done(&self) -> bool {
+        self.pos >= self.chars.len()
+    }
+}
