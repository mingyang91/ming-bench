+use super::error::SourcePos;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Expr {
+    pub kind: ExprKind,
+    pub pos: SourcePos,
+}
+
+impl Expr {
+    pub fn new(kind: ExprKind, pos: SourcePos) -> Self {
+        Self { kind, pos }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum ExprKind {
+    Int(i64),
+    Bool(bool),
+    String(String),
+    Symbol(String),
+    List(Vec<Expr>),
+}
