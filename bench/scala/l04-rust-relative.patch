+use super::env::EnvRef;
+use super::error::{EvalError, SourcePos};
+use super::value::{list_from_vec, proper_list_to_vec, Value};
+
+pub fn install(env: &EnvRef) {
+    define(env, "+", builtin_add);
+    define(env, "-", builtin_sub);
+    define(env, "*", builtin_mul);
+    define(env, "/", builtin_div);
+    define(env, "<", builtin_lt);
+    define(env, ">", builtin_gt);
+    define(env, "=", builtin_eq);
+    define(env, "<=", builtin_le);
+    define(env, "not", builtin_not);
+    define(env, "cons", builtin_cons);
+    define(env, "car", builtin_car);
+    define(env, "cdr", builtin_cdr);
+    define(env, "null?", builtin_null);
+    define(env, "list", builtin_list);
+    define(env, "length", builtin_length);
+    define(env, "append", builtin_append);
+    define(env, "string?", builtin_string_pred);
+    define(env, "number?", builtin_number_pred);
+    define(env, "boolean?", builtin_boolean_pred);
+    define(env, "pair?", builtin_pair_pred);
+    define(env, "symbol?", builtin_symbol_pred);
+}
+
+fn define(
+    env: &EnvRef,
+    name: &'static str,
+    func: fn(&[Value], SourcePos) -> Result<Value, EvalError>,
+) {
+    env.define(name, Value::builtin(name, func));
+}
+
+fn builtin_add(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    let mut total = 0_i64;
+    for arg in args {
+        total += arg.as_number(position)?;
+    }
+    Ok(Value::Int(total))
+}
+
+fn builtin_sub(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    if args.is_empty() {
+        return Err(EvalError::arity("-", "at least 1", 0, position));
+    }
+
+    let first = args[0].as_number(position)?;
+    if args.len() == 1 {
+        return Ok(Value::Int(-first));
+    }
+
+    let rest = args[1..]
+        .iter()
+        .try_fold(first, |acc, value| Ok(acc - value.as_number(position)?))?;
+    Ok(Value::Int(rest))
+}
+
+fn builtin_mul(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    let mut total = 1_i64;
+    for arg in args {
+        total *= arg.as_number(position)?;
+    }
+    Ok(Value::Int(total))
+}
+
+fn builtin_div(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    if args.len() < 2 {
+        return Err(EvalError::arity("/", "at least 2", args.len(), position));
+    }
+
+    let mut total = args[0].as_number(position)?;
+    for value in &args[1..] {
+        let divisor = value.as_number(position)?;
+        if divisor == 0 {
+            return Err(EvalError::division_by_zero(position));
+        }
+        total /= divisor;
+    }
+
+    Ok(Value::Int(total))
+}
+
+fn builtin_lt(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    compare_numbers("<", args, position, |a, b| a < b)
+}
+
+fn builtin_gt(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    compare_numbers(">", args, position, |a, b| a > b)
+}
+
+fn builtin_eq(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    compare_numbers("=", args, position, |a, b| a == b)
+}
+
+fn builtin_le(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    compare_numbers("<=", args, position, |a, b| a <= b)
+}
+
+fn builtin_not(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("not", args, 1, position)?;
+    Ok(Value::Bool(!args[0].is_truthy()))
+}
+
+fn builtin_cons(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("cons", args, 2, position)?;
+    Ok(Value::cons(args[0].clone(), args[1].clone()))
+}
+
+fn builtin_car(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("car", args, 1, position)?;
+    match &args[0] {
+        Value::Pair(pair) => Ok(pair.car.clone()),
+        other => Err(EvalError::type_error("pair", other.type_name(), position)),
+    }
+}
+
+fn builtin_cdr(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("cdr", args, 1, position)?;
+    match &args[0] {
+        Value::Pair(pair) => Ok(pair.cdr.clone()),
+        other => Err(EvalError::type_error("pair", other.type_name(), position)),
+    }
+}
+
+fn builtin_null(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("null?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::Nil)))
+}
+
+fn builtin_list(args: &[Value], _position: SourcePos) -> Result<Value, EvalError> {
+    Ok(list_from_vec(args.to_vec()))
+}
+
+fn builtin_length(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("length", args, 1, position)?;
+    let items = proper_list_to_vec(&args[0], position)?;
+    Ok(Value::Int(items.len() as i64))
+}
+
+fn builtin_append(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    if args.is_empty() {
+        return Ok(Value::Nil);
+    }
+
+    let mut result = args.last().cloned().unwrap_or(Value::Nil);
+    for list in args[..args.len() - 1].iter().rev() {
+        let items = proper_list_to_vec(list, position)?;
+        for item in items.into_iter().rev() {
+            result = Value::cons(item, result);
+        }
+    }
+
+    Ok(result)
+}
+
+fn builtin_string_pred(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("string?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::String(_))))
+}
+
+fn builtin_number_pred(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("number?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::Int(_))))
+}
+
+fn builtin_boolean_pred(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("boolean?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::Bool(_))))
+}
+
+fn builtin_pair_pred(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("pair?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::Pair(_))))
+}
+
+fn builtin_symbol_pred(args: &[Value], position: SourcePos) -> Result<Value, EvalError> {
+    expect_exact_arity("symbol?", args, 1, position)?;
+    Ok(Value::Bool(matches!(args[0], Value::Symbol(_))))
+}
+
+fn compare_numbers(
+    name: &'static str,
+    args: &[Value],
+    position: SourcePos,
+    predicate: fn(i64, i64) -> bool,
+) -> Result<Value, EvalError> {
+    if args.len() < 2 {
+        return Err(EvalError::arity(name, "at least 2", args.len(), position));
+    }
+
+    let numbers = args
+        .iter()
+        .map(|value| value.as_number(position))
+        .collect::<Result<Vec<_>, _>>()?;
+    let is_valid = numbers.windows(2).all(|pair| predicate(pair[0], pair[1]));
+    Ok(Value::Bool(is_valid))
+}
+
+fn expect_exact_arity(
+    name: &'static str,
+    args: &[Value],
+    expected: usize,
+    position: SourcePos,
+) -> Result<(), EvalError> {
+    if args.len() == expected {
+        return Ok(());
+    }
+
+    Err(EvalError::arity(
+        name,
+        expected.to_string(),
+        args.len(),
+        position,
+    ))
+}
