(define (classify n)
  (cond ((zero? n) 'zero)
        ((and (positive? n) (even? n)) 'pos-even)
        ((and (positive? n) (odd? n)) 'pos-odd)
        ((and (negative? n) (even? n)) 'neg-even)
        (else 'neg-odd)))
(and (eq? (classify 0) 'zero)
     (eq? (classify 6) 'pos-even)
     (eq? (classify 7) 'pos-odd)
     (eq? (classify -4) 'neg-even)
     (eq? (classify -3) 'neg-odd))